{
  "id": "VeritasRemind001",
  "name": "Veritas - daily reminder of pending reviews",
  "active": false,
  "nodes": [
    {
      "id": "7d2e7a2f-0b02-4c7b-8c9b-000000000001",
      "name": "Every day at 9:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 9
            }
          ]
        }
      }
    },
    {
      "id": "7d2e7a2f-0b02-4c7b-8c9b-000000000002",
      "name": "Run now (manual test)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ],
      "parameters": {}
    },
    {
      "id": "7d2e7a2f-0b02-4c7b-8c9b-000000000003",
      "name": "Get reminders from Veritas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        100
      ],
      "parameters": {
        "method": "GET",
        "url": "__VERITAS_API__/api/automation/digest?kind=reminder",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Veritas-Token",
              "value": "__AUTOMATION_TOKEN__"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "7d2e7a2f-0b02-4c7b-8c9b-inbox",
      "name": "Post to Veritas inbox",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        -150
      ],
      "parameters": {
        "method": "POST",
        "url": "__VERITAS_API__/api/notifications",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Veritas-Token",
              "value": "__AUTOMATION_TOKEN__"
            }
          ]
        },
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      }
    },
    {
      "id": "7d2e7a2f-0b02-4c7b-8c9b-split",
      "name": "Email only in send mode",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        100
      ],
      "parameters": {
        "jsCode": "// Veritas decides; n8n delivers. email_mode comes from Veritas settings (off | preview | send).\nreturn $input.all()\n  .map(i => i.json)\n  .filter(m => m.email_mode === 'send' && (m.recipients || []).length)\n  .map(m => ({ json: { ...m, to: m.recipients.join(', ') } }));"
      }
    },
    {
      "id": "7d2e7a2f-0b02-4c7b-8c9b-email",
      "name": "Email (add SMTP credentials, then enable)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        960,
        100
      ],
      "parameters": {
        "fromEmail": "veritas@example.com",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.title }}",
        "emailFormat": "text",
        "text": "={{ $json.body }}\n\nReview it in Veritas (sign-in required): {{ $json.link }}",
        "options": {}
      },
      "disabled": true,
      "onError": "continueRegularOutput"
    },
    {
      "id": "7d2e7a2f-0b02-4c7b-8c9b-result",
      "name": "Email result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        100
      ],
      "parameters": {
        "jsCode": "const sent = $('Email only in send mode').all();\nreturn $input.all().map((item, i) => {\n  const out = item.json, ids = sent[i].json.delivery_ids;\n  if (out.error) return { json: { delivery_ids: ids, status: 'failed', error: String(out.error.message || out.error).slice(0, 400) } };\n  if (Array.isArray(out.accepted) && out.accepted.length) return { json: { delivery_ids: ids, status: 'sent' } };\n  return { json: { delivery_ids: ids, status: 'skipped', error: 'The email node is disabled or not configured in n8n: add SMTP credentials and enable it.' } };\n});"
      }
    },
    {
      "id": "7d2e7a2f-0b02-4c7b-8c9b-preview",
      "name": "Preview / email off",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "jsCode": "// Preview mode: report what WOULD have been emailed, without sending anything.\nreturn $input.all()\n  .map(i => i.json)\n  .filter(m => !(m.email_mode === 'send' && (m.recipients || []).length))\n  .map(m => ({ json: {\n    delivery_ids: m.delivery_ids,\n    status: m.email_mode === 'preview' ? 'preview' : 'skipped',\n    error: m.email_mode === 'preview'\n      ? `Preview only, not sent. Would email ${(m.recipients || []).join(', ') || 'nobody (no recipients set)'}: ${m.title}`\n      : (m.email_mode === 'send' ? 'No recipients set' : 'Email is off for this organization'),\n  } }));"
      }
    },
    {
      "id": "7d2e7a2f-0b02-4c7b-8c9b-report",
      "name": "Report delivery to Veritas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "__VERITAS_API__/api/automation/deliveries",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Veritas-Token",
              "value": "__AUTOMATION_TOKEN__"
            }
          ]
        },
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      }
    }
  ],
  "connections": {
    "Every day at 9:00": {
      "main": [
        [
          {
            "node": "Get reminders from Veritas",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run now (manual test)": {
      "main": [
        [
          {
            "node": "Get reminders from Veritas",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get reminders from Veritas": {
      "main": [
        [
          {
            "node": "Post to Veritas inbox",
            "type": "main",
            "index": 0
          },
          {
            "node": "Email only in send mode",
            "type": "main",
            "index": 0
          },
          {
            "node": "Preview / email off",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email only in send mode": {
      "main": [
        [
          {
            "node": "Email (add SMTP credentials, then enable)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email (add SMTP credentials, then enable)": {
      "main": [
        [
          {
            "node": "Email result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email result": {
      "main": [
        [
          {
            "node": "Report delivery to Veritas",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Preview / email off": {
      "main": [
        [
          {
            "node": "Report delivery to Veritas",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
