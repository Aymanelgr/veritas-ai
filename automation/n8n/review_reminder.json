{
  "id": "VeritasRemind001",
  "name": "Veritas - daily reminder of pending reviews",
  "active": false,
  "nodes": [
    {
      "id": "7d2e7a2f-0b02-4c7b-8c9b-000000000001",
      "name": "Every day at 9:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": {
        "rule": { "interval": [{ "field": "days", "triggerAtHour": 9 }] }
      }
    },
    {
      "id": "7d2e7a2f-0b02-4c7b-8c9b-000000000005",
      "name": "Run now (manual test)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 200],
      "parameters": {}
    },
    {
      "id": "7d2e7a2f-0b02-4c7b-8c9b-000000000002",
      "name": "Get pending findings",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0],
      "parameters": {
        "url": "__VERITAS_API__/api/findings?review_status=pending",
        "options": {}
      },
      "alwaysOutputData": true
    },
    {
      "id": "7d2e7a2f-0b02-4c7b-8c9b-000000000003",
      "name": "Summarize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 0],
      "parameters": {
        "jsCode": "// n8n turns the JSON array into one item per finding.\nconst findings = $input.all().map(i => i.json).filter(f => f.id);\nif (findings.length === 0) return []; // nothing pending: stop here, no reminder\nconst critical = findings.filter(f => f.severity === 'critical').length;\nreturn [{ json: {\n  kind: 'reminder',\n  title: `Reminder: ${findings.length} finding(s) awaiting review (${critical} critical)`,\n  body: findings.slice(0, 10).map(f => `- ${f.document_filename}: ${f.claim}`).join('\\n'),\n  link: '__DASHBOARD_URL__/reviews',\n}}];"
      }
    },
    {
      "id": "7d2e7a2f-0b02-4c7b-8c9b-000000000004",
      "name": "Post to Veritas inbox",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 0],
      "parameters": {
        "method": "POST",
        "url": "__VERITAS_API__/api/notifications",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "X-Veritas-Token", "value": "__AUTOMATION_TOKEN__" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Every day at 9:00": { "main": [[{ "node": "Get pending findings", "type": "main", "index": 0 }]] },
    "Run now (manual test)": { "main": [[{ "node": "Get pending findings", "type": "main", "index": 0 }]] },
    "Get pending findings": { "main": [[{ "node": "Summarize", "type": "main", "index": 0 }]] },
    "Summarize": { "main": [[{ "node": "Post to Veritas inbox", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
